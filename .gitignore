/pilots/AUE_PILOT_001/results/R2_RESTART_ATTEMPT_2026-11-05/run/*
!/pilots/AUE_PILOT_001/results/R2_RESTART_ATTEMPT_2026-11-05/run/R2_CAD_ATTEMPT.txt
