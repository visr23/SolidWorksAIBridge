        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "solid"
          ]
        },
        "bounds": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "available"
                  ]
                },
                "value": {
                  "$ref": "#/definitions/bounds"
                },
                "reason": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unsupported",
                    "not_applicable"
                  ]
                },
                "value": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "volume": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "available"
                  ]
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "reason": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unsupported",
                    "not_applicable"
                  ]
                },
                "value": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "volumeUnit": {
          "enum": [
            "m3",
            "mm3",
            "cm3",
            "in3",
            "unknown"
          ]
        },
        "featureIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nativeType",
        "treeParentId",
        "dependsOn",
