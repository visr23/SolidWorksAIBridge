{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:solidworks-ai-bridge:building-analysis:0.1.0",
  "title": "building-analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "buildingId",
    "manifestId",
    "sourceRevision",
    "synthetic",
    "run",
    "documents",
    "claims",
    "candidates",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "0.1.0"
      ]
    },
    "analysisId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "buildingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "utc",
        "tool",
        "toolVersion",
        "environment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "utc": {
          "type": "string",
          "format": "date-time"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/document"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/claim"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/candidate"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "definitions": {
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "documentId",
        "configurationId",
        "nativeReference",
        "method",
        "confidence"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "documentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "configurationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "nativeReference": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "status",
        "reason"
      ],
      "properties": {
        "category": {
          "enum": [
            "bodies",
            "features",
            "sketches",
            "dimensions",
            "dependencies",
            "assemblies",
            "equations"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unsupported",
            "unavailable",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "angle",
        "scaleDomain",
        "architecturalScale"
      ],
      "properties": {
        "length": {
          "enum": [
            "m",
            "mm",
            "cm",
            "in",
            "unknown"
          ]
        },
        "angle": {
          "enum": [
            "rad",
            "deg",
            "unknown"
          ]
        },
        "scaleDomain": {
          "enum": [
            "architectural",
            "miniature",
            "unknown"
          ]
        },
        "architecturalScale": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "available"
                  ]
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "reason": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unsupported",
                    "not_applicable"
                  ]
                },
                "value": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "xAxis",
        "yAxis",
        "zAxis",
        "handedness",
        "lengthUnit",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "xAxis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "yAxis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "zAxis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "handedness": {
          "enum": [
            "right"
          ]
        },
        "lengthUnit": {
          "enum": [
            "m",
            "mm",
            "cm",
            "in",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "frameId",
        "method",
        "approximate",
        "tolerance"
      ],
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "frameId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "approximate": {
          "type": "boolean"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "bounds",
        "volume",
