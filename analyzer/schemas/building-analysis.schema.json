              "properties": {
                "status": {
                  "enum": [
                    "available"
                  ]
                },
                "value": {
                  "type": "integer",
                  "minimum": 0
                },
                "reason": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unsupported",
                    "not_applicable"
                  ]
                },
                "value": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "relations": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
