                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "available"
                  ]
                },
                "value": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reason": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unsupported",
                    "not_applicable"
                  ]
                },
                "value": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "dimensionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      }
    },
