          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "frameId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "entityCount": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
