            }
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "bodyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "suppression": {
          "enum": [
            "active",
            "suppressed",
            "unknown"
          ]
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      }
    },
    "sketch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "featureId",
        "frameId",
        "entityCount",
        "relations",
        "dimensionIds",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
